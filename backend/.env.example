# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (no trailing slash, no wildcard)
# Defaults (hardcoded fallback): http://localhost:3000, https://ecommerce-site-dun-phi.vercel.app
CORS_ORIGIN=http://localhost:3000,https://ecommerce-site-dun-phi.vercel.app

# ─── Supabase ─────────────────────────────────────────────────────────────────
# Public anon key only — used for token verification and public reads
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
# NEVER expose this to frontend — server-side only
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ─── Razorpay ─────────────────────────────────────────────────────────────────
# Server-side only — NEVER expose RAZORPAY_KEY_SECRET to frontend
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret

